# Copie ce fichier en ".env" (jamais commité sur Git) et remplis avec tes vraies valeurs.

# URL JDBC de la base PostgreSQL locale (via docker-compose.yml) :
DATABASE_URL=jdbc:postgresql://localhost:5432/fboplus
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_local

# Clé secrète pour signer les jetons JWT (authentification) — génère une vraie
# valeur aléatoire longue avant la mise en production, ne jamais réutiliser
# une clé d'exemple.
JWT_SECRET=change_moi_avec_une_vraie_cle_secrete_longue

PORT=8080
